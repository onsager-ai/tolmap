# Railway staging environment -- the committed copy of what the staging
# service's variables must be. Railway keeps variables in its own dashboard,
# which is exactly the kind of state that drifts from the repo without
# anyone noticing, so this file is the reviewable source and
# scripts/check_deploy_env_parity.py fails CI when it and fly.toml's [env]
# stop describing the same set of knobs.
#
# Apply it with the Railway CLI, from the staging service:
#   railway variables --set-from-file deploy/railway.staging.env
# (or paste into the dashboard's raw editor -- same content either way).
#
# Values that are IDENTICAL to production are identical on purpose. A
# staging box tuned differently from prod is not a staging box, it is a
# second product with its own settings. docs/DEPLOY.md
# records the three deltas that are unavoidable, below.

# --- Delta 1: the port. src/service/config.rs reads TOLMAP_PORT, not the
# PORT that Railway injects, so the injected value is forwarded by
# reference. Fly does not need this: fly.toml's internal_port matches the
# compiled-in default (8787) and leaves TOLMAP_PORT unset.
TOLMAP_PORT=${{PORT}}

# Same as prod, and just as required: bind off-box or Railway's router
# cannot reach the process and the healthcheck never goes green.
TOLMAP_BIND_ADDR=0.0.0.0

# --- Delta 2 (operational, not a value): these two paths REQUIRE a Railway
# volume mounted at /data. Railway's container filesystem does not survive
# a redeploy, and losing the store costs district retention specifically --
# docs/FINDINGS.md finding 4: the warm start reads the previous commit's
# membership out of it, and without one every staging index is a cold
# start (46% retention, not 88%). A 5 GB volume is enough here: the clone
# cache is managed by TOLMAP_CLONE_CACHE_BYTES below, and maps are small.
TOLMAP_DB_PATH=/data/tolmap.sqlite3
TOLMAP_CACHE_DIR=/data/cache

TOLMAP_PRUNE_VARIANT=node-relative

# --- Limits: identical to fly.toml, deliberately. The arithmetic behind
# each of these is in fly.toml's own comments; it is not repeated here,
# because two copies of a justification drift the same way two copies of a
# value do. Change one side and CI will make you change the other.
TOLMAP_CLONE_CACHE_BYTES=1073741824
TOLMAP_MAX_CONCURRENT_JOBS=1
TOLMAP_MAX_QUEUED_JOBS=16
TOLMAP_RATE_LIMIT_PER_IP=30
TOLMAP_RATE_LIMIT_WINDOW_SECONDS=60
TOLMAP_RATE_LIMIT_PER_REPO=3
TOLMAP_RATE_LIMIT_PER_REPO_WINDOW_SECONDS=300
TOLMAP_RETAIN_COMMITS_PER_REPO=5

# --- Delta 3: TOLMAP_STATIC_DIR is baked into the image (Dockerfile ENV)
# and is not set on either side. Listed here only so its absence reads as
# a decision rather than an omission.
